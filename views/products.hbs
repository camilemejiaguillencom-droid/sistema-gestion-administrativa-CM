<h2>Productos</h2>
{{#if error}}<p class="error">{{error}}</p>{{/if}}
<div class="card">
  <form class="filters" method="get" action="/productos">
    <label>Buscar <input name="q" value="{{q}}" placeholder="Nombre, categoría o ubicación"></label>
    <button type="submit">Consultar</button>
  </form>
</div>
<div class="card">
  <h3>Registrar producto</h3>
  <form class="row" method="post" action="/productos">
    <label>Nombre <input name="name" required></label>
    <label>Categoría
      <select name="category">{{#each categories}}<option>{{this}}</option>{{/each}}</select>
    </label>
    <label>Cantidad <input type="number" name="quantity" min="0" value="0" required></label>
    <label>Precio compra <input type="number" step="0.01" name="purchasePrice" min="0" required></label>
    <label>Precio venta <input type="number" step="0.01" name="salePrice" min="0" required></label>
    <label>Ubicación <input name="location" placeholder="Estante, caja, zona..."></label>
    <label>Observaciones <input name="notes"></label>
    <button type="submit">Guardar</button>
  </form>
</div>
<div class="card table-wrap">
  <table>
    <thead><tr><th>Nombre</th><th>Categoría</th><th>Cant.</th><th>Compra</th><th>Venta</th><th>Ubicación</th><th>Obs.</th><th></th></tr></thead>
    <tbody>
      {{#each items}}
      <tr>
        <td>{{name}}</td><td>{{category}}</td><td>{{quantity}}</td>
        <td>{{money purchasePrice}}</td><td>{{money salePrice}}</td>
        <td>{{location}}</td><td>{{notes}}</td>
        <td class="actions">
          <a class="btn btn-light" href="/productos/{{id}}/editar">Editar</a>
          <form method="post" action="/productos/{{id}}/eliminar" onsubmit="return confirm('¿Eliminar producto?')">
            <button class="btn-danger" type="submit">Eliminar</button>
          </form>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
