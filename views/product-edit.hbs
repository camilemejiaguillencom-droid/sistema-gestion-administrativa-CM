<h2>Editar producto</h2>
<div class="card">
  {{#if item}}
  <form class="row" method="post" action="/productos/{{item.id}}">
    <label>Nombre <input name="name" value="{{item.name}}" required></label>
    <label>Categoría
      <select name="category">
        {{#each categories}}
        <option value="{{this}}" {{#if (eq this ../item.category)}}selected{{/if}}>{{this}}</option>
        {{/each}}
      </select>
    </label>
    <label>Cantidad <input type="number" name="quantity" min="0" value="{{item.quantity}}" required></label>
    <label>Precio compra <input type="number" step="0.01" name="purchasePrice" min="0" value="{{item.purchasePrice}}" required></label>
    <label>Precio venta <input type="number" step="0.01" name="salePrice" min="0" value="{{item.salePrice}}" required></label>
    <label>Ubicación <input name="location" value="{{item.location}}"></label>
    <label>Observaciones <input name="notes" value="{{item.notes}}"></label>
    <button type="submit">Actualizar</button>
    <a class="btn btn-light" href="/productos">Volver</a>
  </form>
  {{else}}<p>No encontrado.</p>{{/if}}
</div>
