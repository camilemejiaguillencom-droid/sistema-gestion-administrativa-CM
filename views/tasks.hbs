<h2>Tareas</h2>
<div class="card">
  <form class="filters" method="get" action="/tareas">
    <label>Estado
      <select name="estado">
        <option value="">Todas</option>
        <option value="Pendiente" {{#if (eq estado 'Pendiente')}}selected{{/if}}>Pendiente</option>
        <option value="Completada" {{#if (eq estado 'Completada')}}selected{{/if}}>Completada</option>
      </select>
    </label>
    <button type="submit">Filtrar</button>
  </form>
</div>
<div class="card">
  <h3>Registrar tarea</h3>
  <form class="row" method="post" action="/tareas">
    <label>Nombre <input name="name" required></label>
    <label>Descripción <input name="description"></label>
    <label>Fecha <input type="date" name="date" required></label>
    <label>Fecha límite <input type="date" name="dueDate" required></label>
    <label>Prioridad
      <select name="priority">{{#each priorities}}<option>{{this}}</option>{{/each}}</select>
    </label>
    <label>Estado
      <select name="status">{{#each statuses}}<option>{{this}}</option>{{/each}}</select>
    </label>
    <button type="submit">Guardar</button>
  </form>
</div>
<div class="card table-wrap">
  <table>
    <thead><tr><th>Nombre</th><th>Descripción</th><th>Fecha</th><th>Límite</th><th>Prioridad</th><th>Estado</th><th></th></tr></thead>
    <tbody>
      {{#each items}}
      <tr>
        <td>{{name}}</td><td>{{description}}</td><td>{{date}}</td><td>{{dueDate}}</td>
        <td>{{priority}}</td><td>{{status}}</td>
        <td class="actions">
          <form method="post" action="/tareas/{{id}}/estado">
            <button type="submit">{{#if (eq status 'Completada')}}Marcar pendiente{{else}}Completar{{/if}}</button>
          </form>
          <a class="btn btn-light" href="/tareas/{{id}}/editar">Editar</a>
          <form method="post" action="/tareas/{{id}}/eliminar" onsubmit="return confirm('¿Eliminar tarea?')">
            <button class="btn-danger" type="submit">Eliminar</button>
          </form>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
