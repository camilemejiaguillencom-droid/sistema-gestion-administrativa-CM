<h2>Resumen económico</h2>
<div class="card">
  <form class="filters" method="get" action="/">
    <label>Desde <input type="date" name="from" value="{{from}}"></label>
    <label>Hasta <input type="date" name="to" value="{{to}}"></label>
    <button type="submit">Consultar</button>
    <a class="btn btn-light" href="/">Ver todo</a>
  </form>
</div>
<div class="grid">
  <div class="card"><div class="muted">Ingresos</div><div class="kpi">{{income}}</div></div>
  <div class="card"><div class="muted">Gastos</div><div class="kpi">{{expense}}</div></div>
  <div class="card"><div class="muted">Balance</div><div class="kpi">{{balance}}</div></div>
</div>
<div class="card">
  <h3>Tareas pendientes</h3>
  {{#if pending.length}}
  <ul>{{#each pending}}<li><strong>{{name}}</strong> · límite {{dueDate}} · {{priority}}</li>{{/each}}</ul>
  {{else}}<p class="muted">No hay tareas pendientes.</p>{{/if}}
</div>
<div class="card">
  <h3>Ubicación de productos</h3>
  <p class="muted">Consulta rápida para ubicar mercancía en el espacio disponible.</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Producto</th><th>Categoría</th><th>Cantidad</th><th>Ubicación</th></tr></thead>
      <tbody>
        {{#each products}}
        <tr><td>{{name}}</td><td>{{category}}</td><td>{{quantity}}</td><td>{{location}}</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
