<h2>Ventas e ingresos</h2>
{{#if error}}<p class="error">{{error}}</p>{{/if}}
<div class="card">
  <form class="filters" method="get" action="/ventas">
    <label>Desde <input type="date" name="from" value="{{from}}"></label>
    <label>Hasta <input type="date" name="to" value="{{to}}"></label>
    <button type="submit">Consultar</button>
    <a class="btn btn-light" href="/ventas">Ver todo</a>
  </form>
  <p><strong>Total ingresos:</strong> {{total}}</p>
</div>
<div class="card">
  <h3>Registrar venta</h3>
  <form class="row" method="post" action="/ventas">
    <label>Fecha <input type="date" name="date" required></label>
    <label>Producto
      <select name="productId" required>
        <option value="">Seleccione</option>
        {{#each products}}<option value="{{id}}">{{name}} ({{quantity}} disp. · {{location}})</option>{{/each}}
      </select>
    </label>
    <label>Cantidad <input type="number" name="quantity" min="1" value="1" required></label>
    <label>Valor de la venta <input type="number" step="0.01" name="amount" min="0" placeholder="Vacío = precio × cant."></label>
    <label>Forma de pago
      <select name="paymentMethod">{{#each payments}}<option>{{this}}</option>{{/each}}</select>
    </label>
    <label>Observación <input name="notes"></label>
    <button type="submit">Guardar</button>
  </form>
</div>
<div class="card table-wrap">
  <table>
    <thead><tr><th>Fecha</th><th>Producto</th><th>Cant.</th><th>Valor</th><th>Pago</th><th>Obs.</th></tr></thead>
    <tbody>
      {{#each items}}
      <tr>
        <td>{{date}}</td><td>{{product.name}}</td><td>{{quantity}}</td>
        <td>{{money amount}}</td><td>{{paymentMethod}}</td><td>{{notes}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
